{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    },
    "types": [
      "jest"
    ]
  },
  "exclude": [
    "node_modules",
    "functions",
    "tests",
    "scripts"
  ]
}
