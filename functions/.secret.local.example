# Copiá este archivo como .secret.local (no se sube al repositorio).
# En el emulador, las Functions leen los secretos de acá. En producción van en Secret Manager:
#   firebase functions:secrets:set MAKE_WEBHOOK_SECRET
MAKE_WEBHOOK_SECRET=solo-para-el-emulador

# Firma de los webhooks de Cal.com (endpoint reservaCalcom).
CALCOM_WEBHOOK_SECRET=solo-para-el-emulador

# Envío del enlace mágico por SMTP (Gmail o Workspace del Dr.: contraseña de aplicación).
# Vacíos = no se manda ningún mail; en el emulador el enlace se devuelve para probar.
SMTP_USUARIO=
SMTP_CLAVE=
