# Variables públicas de la app (Expo). Copiá este archivo como .env.local (no se sube al repositorio).
# La configuración web de Firebase no es secreta: identifica el proyecto. Los secretos van en
# Secret Manager (Functions), nunca acá. Se completan cuando exista el proyecto real "pediatric-os".

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-pediatric-os
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_APP_ID=

# De dónde salen los datos: demo (en memoria, con selector de rol) o firebase (ingreso real).
# Atajo para la web con Firebase: npm run web:firebase (puerto 8083).
EXPO_PUBLIC_DATOS=demo

# En desarrollo la app habla con los emuladores (npm run emuladores, y npm run sembrar).
EXPO_PUBLIC_USE_EMULATORS=true
# Para probar en el iPhone con los emuladores: la IP de la Mac en la misma red Wi-Fi
# (el túnel de Expo no llega a los emuladores). En la computadora, dejalo vacío.
EXPO_PUBLIC_EMULADOR_HOST=

# EN PRODUCCIÓN (web con Firebase Hosting o la app compilada con EAS):
#   EXPO_PUBLIC_DATOS=firebase
#   EXPO_PUBLIC_USE_EMULATORS=false
#   y los cinco EXPO_PUBLIC_FIREBASE_* del proyecto real (Consola de Firebase › Configuración › Tus apps).
# Pasos completos en docs/INSTALACION.md.

# Las Cloud Functions NO leen este archivo. Tienen lo suyo:
#
# Secretos (Secret Manager en producción: npx firebase functions:secrets:set NOMBRE;
# en el emulador, functions/.secret.local, a partir de functions/.secret.local.example):
#   MAKE_WEBHOOK_SECRET    firma HMAC de lo que sale hacia Make y de lo que entra desde Make
#   CALCOM_WEBHOOK_SECRET  firma de los webhooks de Cal.com (endpoint reservaCalcom)
#   SMTP_USUARIO           cuenta que manda el enlace mágico (vacía = no sale ningún mail)
#   SMTP_CLAVE             contraseña de aplicación de esa cuenta
#   ANTHROPIC_API_KEY      IA Asistente (vacía = la IA no responde aunque esté encendida)
#
# Parámetros (functions/.env.<id-del-proyecto>; para el emulador, functions/.env.demo-pediatric-os):
#   ORGANIZACION_ID        id de la organización del Dr. (el que usó scripts/primer-medico.ts)
#   URL_APP                dirección de la web, para armar el enlace mágico (https://…)
#   MAKE_WEBHOOK_URL       URL del escenario "Pediatric OS — eventos". Vacía = los eventos quedan "sin_destino".
