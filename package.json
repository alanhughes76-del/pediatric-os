{
  "name": "pediatria-domicilio",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.28",
    "expo-sharing": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "firebase": "12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "firebase-admin": "13.10.0",
    "firebase-tools": "15.32.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p scripts && tsc --noEmit -p functions",
    "lint": "expo lint",
    "test": "jest",
    "test:reglas": "firebase emulators:exec --only firestore,storage --project demo-pediatric-os \"jest -c jest.reglas.config.js\"",
    "test:funciones": "jest -c jest.funciones.config.js",
    "test:integracion": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions --project demo-pediatric-os \"jest -c jest.integracion.config.js\"",
    "emuladores": "npm --prefix functions run build && firebase emulators:start --project demo-pediatric-os",
    "sembrar": "tsx scripts/sembrar.ts",
    "web:firebase": "EXPO_PUBLIC_DATOS=firebase expo start --web --port 8083"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^expo-modules-core$": "<rootDir>/node_modules/expo/node_modules/expo-modules-core",
      "^expo-modules-core/(.*)$": "<rootDir>/node_modules/expo/node_modules/expo-modules-core/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1"
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/shared/**/*.test.ts"
    ]
  }
}
