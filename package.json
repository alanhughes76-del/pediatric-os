{
  "name": "pediatria-domicilio",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.20",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.27",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "firebase": "12.19.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/jest": "30.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "firebase-admin": "13.10.0",
    "firebase-tools": "15.32.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p scripts && tsc --noEmit -p functions",
    "lint": "expo lint",
    "test": "jest",
    "test:reglas": "firebase emulators:exec --only firestore,storage --project demo-pediatric-os \"jest -c jest.reglas.config.js\"",
    "test:funciones": "jest -c jest.funciones.config.js",
    "test:integracion": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions,storage --project demo-pediatric-os \"jest -c jest.integracion.config.js\"",
    "emuladores": "npm --prefix functions run build && firebase emulators:start --project demo-pediatric-os",
    "sembrar": "tsx scripts/sembrar.ts",
    "web:firebase": "EXPO_PUBLIC_DATOS=firebase expo start --web --port 8083",
    "primer-medico": "tsx scripts/primer-medico.ts",
    "web:exportar": "expo export -p web"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1"
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/shared/**/*.test.ts"
    ]
  }
}
